# Configure unique, long staff credentials in Vercel or local .env.
DEBRIX_STAFF_ACCOUNTS_JSON=
DEBRIX_SESSION_SECRET=

# Optional role-specific passcodes for a small local demo.
DEBRIX_OPERATOR_PASSCODE=
DEBRIX_TRANSPORTER_PASSCODE=
DEBRIX_RECYCLER_PASSCODE=
DEBRIX_ADMIN_PASSCODE=

# Neon/Postgres, server-side only. Vercel Marketplace commonly provides POSTGRES_URL.
POSTGRES_URL=
# Optional aliases accepted by the API and migration scripts:
DATABASE_URL=
NEON_DATABASE_URL=

# Required only to read existing legacy Blob evidence or import the old JSON snapshot.
BLOB_READ_WRITE_TOKEN=

# Local server settings.
PORT=4173
DEBRIX_DATA_DIR=data
