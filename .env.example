# Recommended: explicit per-person staff identities. Set in Vercel or quote this JSON in .env.
# DEBRIX_STAFF_ACCOUNTS_JSON=[{"role":"operator","username":"dispatch1","passcode":"use-a-long-random-secret"},{"role":"transporter","username":"driver1","passcode":"use-a-different-long-secret"},{"role":"recycler","username":"facility1","passcode":"use-another-long-secret"}]
DEBRIX_STAFF_ACCOUNTS_JSON=

# Keep a stable, random secret in every deployment environment. Changing it invalidates staff sessions.
DEBRIX_SESSION_SECRET=

# Optional role-specific passcodes for small local demos. Explicit account JSON is recommended for deployment.
DEBRIX_OPERATOR_PASSCODE=
DEBRIX_TRANSPORTER_PASSCODE=
DEBRIX_RECYCLER_PASSCODE=

# Legacy operator-only fallback for existing local/demo setups.
DEBRIX_ADMIN_PASSCODE=

# Local server settings.
PORT=4173
DEBRIX_DATA_DIR=data
