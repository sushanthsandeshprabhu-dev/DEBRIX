# Optional. OpenAQ v3 requires an API key. No live air readings are generated without it.
OPENAQ_API_KEY=

# Search around central Bengaluru by default; optionally change the search center and radius.
OPENAQ_COORDINATES=12.9716,77.5946
OPENAQ_RADIUS_METERS=25000

# Optional local server port (default 4173).
PORT=4173

